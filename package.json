{
  "name": "tarn",
  "version": "0.2.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm run build:remote",
    "build:remote": "vite build --config vite.remote.config.ts && node scripts/embed-remote.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:ci": "tauri build",
    "build:linux:ci": "tauri build --bundles deb,rpm,appimage",
    "build:macos:ci": "tauri build --bundles app",
    "dmg:bg": "node scripts/make-dmg-background.mjs",
    "probe": "cargo run --release --manifest-path src-tauri/Cargo.toml --bin probe --",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/svelte": "^1.1.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.6",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
